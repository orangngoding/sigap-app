# Salin menjadi .env.local untuk pengembangan, atau isi di dashboard Vercel untuk produksi.
# Jangan pernah meng-commit nilai asli. Kunci yang pernah ter-commit dianggap bocor dan harus dibuat ulang.

# Google Gemini (kunci dari https://aistudio.google.com). Hanya dibaca server.
GEMINI_API_KEY=
# Kosong = gemini-3.5-flash-lite. Per 2026-11-17 gemini-2.5-flash tidak tersedia untuk pengguna baru.
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 = Asisten SIGAP memakai pencarian Google (grounding) dan menampilkan sumber web.
# Perlu kuota grounding di AI Studio; bila kuota 0 (paket gratis), Asisten otomatis menjawab tanpa pencarian.
GEMINI_PENCARIAN=0

# Penyedia kedua (opsional), antarmuka kompatibel OpenAI. Kosong = dilewati.
# Contoh memakai Gemini dengan model berbeda sebagai cadangan saat model utama ramai (503):
LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM2_API_KEY=
LLM2_MODEL=gemini-3.1-flash-lite



# Batas panggilan AI per hari (global). Setelah habis, rencana memakai mode tanpa AI.
AI_DAILY_BUDGET=200

# URL publik (https, tanpa garis miring akhir), dipakai untuk kode QR Kartu Siaga, teks bagikan, dan metadata og:image.
# Kosong = https://sigap-app-itrush.vercel.app saat produksi, http://localhost:3000 saat pengembangan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000